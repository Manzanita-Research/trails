{
  "name": "trails",
  "version": "0.1.0-alpha.7",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build:web": "vite build",
    "build:binaries": "bun scripts/build-binaries.ts",
    "build": "bun run build:web && bun run build:binaries",
    "start": "bun cli/main.ts serve",
    "release:stage": "bun run build && bun scripts/stage-release.ts",
    "collect": "bun cli/main.ts collect --once",
    "test": "bun test",
    "check": "tsc --noEmit",
    "docs:deploy": "bun run --cwd apps/docs deploy",
    "docs:check": "bun run --cwd apps/docs typecheck",
    "feedback:dev": "wrangler dev --config wrangler.feedback.jsonc",
    "feedback:deploy": "wrangler deploy --config wrangler.feedback.jsonc",
    "feedback:list": "wrangler d1 execute trails-beta-feedback --remote --config wrangler.feedback.jsonc --json --command \"SELECT id, kind, message, follow_up, context_json, client_created_at, received_at FROM feedback WHERE expires_at > CAST(strftime('%s','now') AS INTEGER) * 1000 ORDER BY received_at DESC LIMIT 50\"",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build"
  },
  "dependencies": {
    "effect": "^3.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  }
}
