{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trails-docs",
  "compatibility_date": "2026-08-04",
  "routes": [
    {
      "pattern": "trails.manzanita.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
